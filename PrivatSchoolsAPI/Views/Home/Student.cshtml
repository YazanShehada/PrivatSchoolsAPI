@using System.Security.Claims
@{
    ViewData["Title"] = "الطلاب";

    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var currentUserId = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
}

<div id="student-page"
     data-current-user="@currentUserId"
     data-authenticated="@(isAuthenticated ? "true" : "false")">

    <div class="page-head">
        <h2>الطلاب</h2>
        <span id="students-count" class="count-label"></span>
    </div>

    <!-- ---------- students belonging to the signed-in user ---------- -->
    <div id="students-loading" class="loading">جارٍ تحميل الطلاب…</div>

    <div id="students-empty" class="empty" hidden>
        <strong>لا يوجد طلاب</strong>
        <p>لا توجد بيانات طلاب مرتبطة بحسابك حتى الآن.</p>
       
        <a href="/Home/Student/Add" class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            إضافة طالب
        </a>
    </div>
    

    <div id="students-list" hidden>
        <div class="grid-toolbar">
            <a href="/Home/Student/Add" class="btn btn-primary btn-sm">
                <i class="bi bi-person-plus"></i>
                إضافة طالب
            </a>
        </div>
        <div id="students-grid" class="card-grid"></div>
    </div>

    <!-- ---------- selected student ---------- -->
    <section id="student-panel" hidden>
        <!-- tabs -->
        <ul class="nav nav-pills tab-pills" id="student-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-tab="tests" type="button">النتائج</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-tab="absences" type="button">الغياب</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-tab="payments" type="button">المدفوعات</button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- TestResult : no API endpoint yet -->
            <div class="tab-pane active" id="tab-tests" role="tabpanel">
                <div class="empty">
                    <strong>النتائج</strong>
                    لا توجد بيانات لعرضها.
                </div>
            </div>

            <div class="tab-pane" id="tab-absences" role="tabpanel">
                <div id="absences-loading" class="loading" hidden>جارٍ التحميل…</div>
                <div id="absences-empty" class="empty" hidden>
                    <strong>الغياب</strong>
                    لا توجد سجلات غياب.
                </div>
                <div class="table-wrap" id="absences-wrap" hidden>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody id="absences-body"></tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane" id="tab-payments" role="tabpanel">
                <div id="payments-loading" class="loading" hidden>جارٍ التحميل…</div>
                <div id="payments-empty" class="empty" hidden>
                    <strong>المدفوعات</strong>
                    لا توجد سجلات مدفوعات.
                </div>
                <div class="table-wrap" id="payments-wrap" hidden>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>المدفوع</th>
                                <th>المتبقي</th>
                                <th>الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody id="payments-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ---------- choose a student popup ---------- -->
<div id="student-picker" class="modal" role="dialog" aria-modal="true" aria-labelledby="student-picker-title">
    <div class="modal-overlay" data-close></div>
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="student-picker-title">اختر طالباً</h3>
            <button type="button" class="modal-close" data-close aria-label="إغلاق">&times;</button>
        </div>
        <div class="modal-body">
            <p class="modal-hint">لديك أكثر من طالب مسجل، اختر الطالب الذي تريد عرض بياناته.</p>
            <div id="student-picker-list" class="card-grid"></div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline" data-close>إغلاق</button>
            </div>
        </div>
    </div>
</div>

<div id="toasts" class="toasts"></div>

@section Scripts {
    <script src="~/js/student.js" asp-append-version="true"></script>
}
